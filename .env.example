# Copy this file to .env and fill in values as needed. Every value below is a
# placeholder -- never commit real credentials, account IDs, ARNs, model IDs,
# or Knowledge Base IDs to version control.
#
# The application works fully (prediction-only) with NONE of these set.
# Bedrock-grounded explanations are opt-in via BEDROCK_ENABLED.

# --- Generation backend selector ----------------------------------------------
# "bedrock" (default), "anthropic", or "gemini". Only one is active at a time.
# Retrieval (RAG) is separate from this choice -- it runs off the local TF-IDF
# knowledge index (knowledge/index/) regardless of which generation backend
# is selected, unless a Bedrock Knowledge Base is also configured below.
#   - bedrock: uses the settings in the Bedrock section below (AWS console setup required).
#   - anthropic: calls the Anthropic API directly -- no AWS setup required.
#   - gemini: calls the Google Gemini API directly -- has a free usage tier.
AI_PROVIDER=gemini

# --- Direct Anthropic API backend (used when AI_PROVIDER=anthropic) ------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_ID=claude-sonnet-5

# --- Direct Gemini API backend (used when AI_PROVIDER=gemini) ------------------
GOOGLE_API_KEY=
GEMINI_MODEL_ID=gemini-2.5-flash

# --- Master switch (Bedrock backend only) --------------------------------------
# Must be "true" to attempt any Bedrock call. Defaults to false/disabled.
BEDROCK_ENABLED=false

# --- AWS region ---------------------------------------------------------------
AWS_REGION=us-east-1

# --- Optional explicit AWS credentials ---------------------------------------
# Leave these unset to use boto3's standard credential chain (shared config/
# credentials files, an attached IAM role, SSO, etc.) instead. Only set these
# if your deployment environment specifically requires environment-variable
# credentials (e.g. some serverless platforms).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# --- Bedrock resources ---------------------------------------------------------
# Foundation model ID to use for generating explanations (see AWS Bedrock console).
BEDROCK_MODEL_ID=
# Knowledge Base ID to retrieve grounding context from (see AWS Bedrock console).
BEDROCK_KNOWLEDGE_BASE_ID=
# Number of chunks to retrieve per explanation request (1-10).
BEDROCK_RETRIEVAL_K=3

# --- AgentCore Runtime (optional, off by default) -----------------------------
# Master switch. When false (default), /api/explain-risk uses the local
# LangGraph workflow (agent/graph.py) exactly as in Phases 3-5. Only set to
# true once a real AgentCore Runtime has been deployed (see
# infrastructure/agentcore/README.md) -- this project has NOT deployed one
# as of this writing.
USE_AGENTCORE=false
# ARN of the deployed AgentCore Runtime. Required if USE_AGENTCORE=true.
AGENTCORE_RUNTIME_ARN=
# Optional: target a specific runtime endpoint/version, if you publish one.
AGENTCORE_RUNTIME_QUALIFIER=
# Timeout (seconds) for a single AgentCore invocation from the Vercel API.
AGENTCORE_REQUEST_TIMEOUT_SECONDS=30
